doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title= title
    style.
      body { font-family: system-ui, sans-serif; margin: 2rem; color: #222; }
      form { display: grid; gap: 0.75rem; max-width: 28rem; margin-top: 1rem; }
      label { display: grid; gap: 0.25rem; }
      input, textarea { padding: 0.5rem; font: inherit; }
      button { padding: 0.5rem 1rem; font: inherit; justify-self: start; }
  body
    h1 Update Custom Object Form
    form(method="POST" action="/update-cobj")
      label
        | Name
        input(type="text" name="name" required)
      label
        | Bio
        textarea(name="bio" rows="4")
      label
        | Game
        input(type="text" name="game")
      button(type="submit") Create
    p
      a(href="/") Return to the homepage
