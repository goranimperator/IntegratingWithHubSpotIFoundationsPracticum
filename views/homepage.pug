doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title= title
    style.
      body { font-family: system-ui, sans-serif; margin: 2rem; color: #222; }
      table { border-collapse: collapse; width: 100%; margin-top: 1rem; }
      th, td { border: 1px solid #ccc; padding: 0.5rem 0.75rem; text-align: left; vertical-align: top; }
      th { background: #f2f2f2; }
      tr:nth-child(even) td { background: #fafafa; }
  body
    a(href="/update-cobj") Add to this table
    h1 Video game characters
    table
      thead
        tr
          th Name
          th Bio
          th Game
      tbody
        each record in records
          tr
            td= record.properties.name
            td= record.properties.bio
            td= record.properties.game
        else
          tr
            td(colspan="3") No records yet
